{
  "name": "@devopsplaybook.io/otel-utils-fastify",
  "version": "1.7.1",
  "description": "Utility to simplify integration with Open Telemetry for Fastify API Server",
  "keywords": [
    "Open Telemetry",
    "OTel",
    "Traces",
    "Logs",
    "Metrics"
  ],
  "license": "ISC",
  "author": "Didier Hoarau",
  "repository": "git+https://github.com/devopsplaybook-io/otel-utils-fastify.git",
  "homepage": "https://github.com/devopsplaybook-io/otel-utils-fastify#readme",
  "bugs": "https://github.com/devopsplaybook-io/otel-utils-fastify/issues",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.spec.json --noEmit",
    "format": "prettier --write .",
    "lint": "oxlint index.ts src && prettier --check .",
    "test": "jest --coverage"
  },
  "peerDependencies": {
    "@devopsplaybook.io/otel-utils": "^1.9.1",
    "fastify": "^5.0.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@opentelemetry/semantic-conventions": "^1.44.0"
  },
  "devDependencies": {
    "@devopsplaybook.io/otel-utils": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "fastify": "^5.12.7",
    "jest": "^30.5.2",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
